beam, particle=electron, pc=0.1, ex=1e-8, ey=2e-8, sigt=1e-3, sige=1e-3, npart=1e9;
kq = 2;
q1: quadrupole, l=0.2, k1=kq, tilt=0.1;
q2: quadrupole, l=0.2, k1=-kq;
d1: drift, l=0.5;
m1: marker;
de: dipedge, e1=0.05, fint=0.5, hgap=0.01, h=0.1;
b1: sbend, l=1, angle=0.1;
hk: hkicker, l=0.1, kick=0.001;
vk: vkicker, kick=0.002;
s1: sextupole, l=0.1, k2=3;
so: solenoid, l=0.3, ks=0.4;
rf: rfcavity, l=0.5, volt=10, freq=2998, lag=0.25;
rf0: rfcavity, l=0, volt=1, freq=500;
mon: monitor;
c1: rcollimator, l=0.1, xsize=0.01, ysize=0.02;
c2: collimator, l=0.1, apertype=ellipse, aperture={0.01,0.02};
cell: line=(q1,d1,q2,d1);
bl: line=(m1,cell,de,b1,de,hk,vk,s1,so,rf,rf0,mon,c1,c2,-cell);
