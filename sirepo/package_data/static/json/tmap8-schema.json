{
    "appInfo": {
        "tmap8": {
            "longName": "TMAP8",
            "shortName": "TMAP8"
        }
    },
    "appModes": {
        "default": {
            "localRoute": "viz"
        }
    },
    "constants": {
        "canCreateNewSimulation": false,
        "simulationSourceExtension": "i"
    },
    "dynamicFiles": {
        "sirepoLibs": {
            "css": [
                "tmap8.css"
            ],
            "js": [
                "tmap8.js",
                "sirepo-lattice.js"
            ]
        }
    },
    "enum": {
        "Distribution": [
            ["Normal", "Normal"],
            ["Uniform", "Uniform"]
        ]
    },
    "frameIdFields": {
        "plotAnimation": [
            "x", "y1", "y2", "y3", "y4", "y5",
            "experimentalFile", "experimentalLabel", "experimentalXOffset",
            "experimentalXScale", "experimentalYOffset", "experimentalYScale"
        ]
    },
    "localRoutes": {
        "viz": {
            "route": "/visualization/:simulationId",
            "config": {
                "controller": "VizController as viz",
                "templateUrl": "/static/html/tmap8-viz.html"
            }
        }
    },
    "model": {
        "columnUnit": {
            "name": ["Name", "String"],
            "unit": ["Unit", "String"]
        },
        "normalDistribution": {
            "mean": ["Mean", "Float", 0],
            "standard_deviation": ["Standard Deviation", "Float", 1]
        },
        "plotAnimation": {
            "_super": ["_", "model", "_PARAMETER_PLOT_COMMON"],
            "aspectRatio": ["Aspect Ratio", "AspectRatio", "0.5625"],
            "experimentalFile": ["Experimental Data File (.csv, .xlsx)", "InputFile", "", "Two columns of horizontal and vertical values. Rows which are not numeric, such as a header, are skipped."],
            "experimentalLabel": ["Legend Label", "String", "Experiment"],
            "experimentalPosition": ["Y Axis", "AxisPosition", "left", "Plot against the left y axis, with the simulation values, or a separate right y axis"],
            "experimentalXOffset": ["Horizontal Offset", "Float", 0, "Plotted horizontal value = value * scale + offset"],
            "experimentalXScale": ["Horizontal Scale", "Float", 1, "Plotted horizontal value = value * scale + offset"],
            "experimentalYOffset": ["Vertical Offset", "Float", 0, "Plotted vertical value = value * scale + offset"],
            "experimentalYScale": ["Vertical Scale", "Float", 1, "Plotted vertical value = value * scale + offset"]
        },
        "rpnVariable": {
            "name": ["Name", "String"],
            "value": ["Value", "RPNValue"],
            "defaultValue": ["Default Value", "RPNValue"],
            "unit": ["Unit", "String"],
            "uncertaintyDistribution": ["Uncertainty Distribution", "Distribution"],
            "uncertainty": ["", "distribution"]
        },
        "simulationSettings": {
            "dataFiles": ["", "FileNameArray", []],
            "inputFile": ["TMAP8 Input File (.i)", "InputFile"],
            "parameters": ["", "ParameterArray"],
            "units": ["", "ColumnUnitArray"],
            "numSamples": ["Number of Samples", "Integer", 100, "Used for Monte Carlo uncertainty studies"],
            "seed": ["Random Seed", "Integer", 2026, "Used for Monte Carlo uncertainty studies"]
        },
        "uniformDistribution": {
            "lower_bound": ["Lower Bound", "Float", 0],
            "upper_bound": ["Upper Bound", "Float", 1]
        }
    },
    "strings": {
        "completionState": "",
        "importText": "Import a TMAP8 input file (.i)",
        "simulationSource": "TMAP8 Source (*.i)"
    },
    "view": {
        "normalDistribution": {
            "advanced": [
                "mean",
                "standard_deviation"
            ]
        },
        "plotAnimation": {
            "title": "Output Parameters",
            "advanced": [
                ["Main", [
                    [
                        ["Horizontal", [
                            "x"
                        ]],
                        ["Vertical", [
                            "y1",
                            "y2",
                            "y3",
                            "y4",
                            "y5"
                        ]],
                        ["Position", [
                            "y1Position",
                            "y2Position",
                            "y3Position",
                            "y4Position",
                            "y5Position"
                        ]]
                    ],
                    "aspectRatio",
                    "notes"
                ]],
                ["Limits", [
                    [
                        ["Left", [
                            "leftLimit"
                        ]],
                        ["Right", [
                            "rightLimit"
                        ]]
                    ]
                ]],
                ["Experimental Data", [
                    "experimentalFile",
                    "experimentalLabel",
                    "experimentalPosition",
                    "experimentalXScale",
                    "experimentalXOffset",
                    "experimentalYScale",
                    "experimentalYOffset"
                ]]
            ]
        },
        "simulationSettings": {
            "title": "Parameters",
            "basic": [
                "parameters"
            ],
            "advanced": []
        },
        "simulationStatus": {
            "title": "Simulation Status",
            "basic": [
                "simulationSettings.numSamples"
            ],
            "advanced": [
                "simulationSettings.numSamples",
                "simulationSettings.seed"
            ]
        },
        "uniformDistribution": {
            "advanced": [
                "lower_bound",
                "upper_bound"
            ]
        }
    }
}
