            ["peak", "Rescale to Peak Field"],
            ["factor", "Multiply by Scale Factor"]
        ],
        "StatPlotPreset": [
            ["", "Select a Preset…"],
            ["twiss", "Twiss Parameters"],
            ["emittanceSigma", "Emittance & Sigma"],
            ["onAxisFields", "On-axis Fields (Ez, Bz)"],
            ["energyGain", "Energy Gain"],
            ["transverseSize", "Transverse Size & Emittance"],
            ["bunchLength", "Bunch Length & Energy"],
            ["centroidMotion", "Centroid Motion"]
