        "QUADRUPOLE": {
            "_super": ["_", "model", "_ELEMENT"],
            "strengthType": ["Strength Type", "QuadStrengthType", "gradient"],
            "gradient": ["Gradient [T/m]", "Float", 0, "Quadrupole field gradient. Positive is horizontally focusing. Used when Strength Type is Field Gradient."],
            "k1": ["k1 [1/m^2]", "Float", 0, "Normalized focusing strength. Used when Strength Type is Normalized Strength."]
        },
        "RBEND": {
            "_super": ["_", "model", "_ELEMENT"],
            "angle": ["Bend Angle [rad]", "Float", 0, "Total bending angle. The field is computed from the reference momentum."]
        },
        "SOLENOID": {
            "_super": ["_", "model", "_ELEMENT"],
            "fieldSource": ["Field Source", "FieldSource", "analytic"],
            "b_field": ["B Field [T]", "Float", 0, "Used when Field Source is Analytic"],
            "fieldMapFile": ["Field Map File", "InputFile", "", "1D on-axis Bz field map (two columns: s [m], Bz [T]). Used when Field Source is 1D Field Map."],
            "rescaleMode": ["Rescale Mode", "RescaleMode", "peak"],
            "maxField": ["Peak B Field [T]", "Float", 0, "Rescale the field map so its peak magnitude equals this value"],
            "scaleFactor": ["Scale Factor", "Float", 1, "Multiply the field map values directly by this factor"]
        },
        "CORRECTOR": {
            "_super": ["_", "model", "_ELEMENT"],
            "h_kick": ["Horizontal Kick [mrad]", "Float", 0],
            "v_kick": ["Vertical Kick [mrad]", "Float", 0]
        },
        "CAVITY": {
            "_super": ["_", "model", "_ELEMENT"],
            "fieldSource": ["Field Source", "FieldSource", "analytic"],
            "gradient": ["Gradient [MV/m]", "Float", 0, "Peak on-axis accelerating gradient. Used when Field Source is Analytic."],
            "frequency": ["RF Frequency [Hz]", "Float", 2.998e9],
            "phase": ["Phase [deg]", "Float", 0, "RF phase seen by the reference particle (or offset from on-crest phase, when Autophase RF Elements is enabled)"],
            "fieldMapFile": ["Field Map File", "InputFile", "", "1D on-axis Ez field map (two columns: s [m], Ez [V/m or normalized]). Used when Field Source is 1D Field Map."],
            "rescaleMode": ["Rescale Mode", "RescaleMode", "peak"],
            "maxField": ["Peak E Field [MV/m]", "Float", 0, "Rescale the field map so its peak magnitude equals this value"],
            "scaleFactor": ["Scale Factor", "Float", 1, "Multiply the field map values directly by this factor"]
        },
        "SCREEN": {
            "_super": ["_", "model", "_ELEMENT"]
        }
