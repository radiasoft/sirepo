    "localRoutes": {
        "source": {
            "config": {
                "controller": "SourceController as source",
                "templateUrl": "/static/html/rftrack-source.html"
            }
        },
        "lattice": {
            "route": "/lattice/:simulationId",
            "config": {
                "controller": "LatticeController as lattice",
                "template": "<div data-lattice-tab=\"\" data-controller=\"lattice\"></div>"
            }
        },
        "visualization": {
            "route": "/visualization/:simulationId",
            "config": {
              "controller": "VisualizationController as visualization",
              "templateUrl": "/static/html/rftrack-visualization.html"
            }
        }
    },
    "model": {
        "beamline": {
            "name": ["Name", "ValidatedString"]
        },
        "beamlineReport": {},
        "beam": {
            "particle": ["Particle", "BeamParticle", "electron", "Particle species"],
            "mass": ["Mass [MeV/c^2]", "Float", 0.51099895, "Rest mass, used when particle is Other"],
            "charge": ["Charge [e]", "Float", -1.0, "Charge in units of the elementary charge, used when particle is Other"],
            "pc": ["Reference Momentum [MeV/c]", "Float", 100.0, "Reference (design) momentum of the bunch. When Distribution is From File, this is only used as the autophase reference particle's momentum -- the loaded file's own momenta are used for tracking."],
            "charge_nC": ["Bunch Charge [nC]", "Float", 1.0, "Total bunch charge"],
            "np": ["Macroparticle Count", "Integer", 10000, "Number of macroparticles to generate for tracking"],
            "randomSeed": ["Random Number Seed", "Integer", 5489, "rng_set_seed(): seed for RF_Track's mt19937 random number generator (its own built-in default). Runs with the same seed and inputs are reproducible; change it to intentionally get a different bunch realization."],
            "emit_x": ["Horizontal Normalized Emittance [mm-mrad]", "Float", 1.0],
            "emit_y": ["Vertical Normalized Emittance [mm-mrad]", "Float", 1.0],
            "beta_x": ["Horizontal Beta [m]", "Float", 1.0],
            "beta_y": ["Vertical Beta [m]", "Float", 1.0],
            "alpha_x": ["Horizontal Alpha", "Float", 0.0],
            "alpha_y": ["Vertical Alpha", "Float", 0.0],
            "sigma_t": ["Bunch Length [mm/c]", "Float", 1.0],
            "sigma_pt": ["Relative Energy Spread [permille]", "Float", 1.0],
            "distributionType": ["Distribution", "BeamDistributionType", "twiss", "Twiss parameters generate a bunch analytically. Cathode Emission models photoemission from a cathode with RF_Track's Bunch6dT_Generator, tracked from rest. From File loads a previously-saved particle bunch from an OpenPMD HDF5 file."],
            "distributionFile": ["Distribution File", "InputFile", "", "OpenPMD HDF5 file (iteration 0) containing a saved particle bunch: per-particle position (m), momentum (kg*m/s), and optionally time (s), for the species selected above. Accepts files from this app's own OpenPMD download (any report) or from the AWA rftrack_utils posproc.save_bunch_to_openpmd() helper."],
            "fromFileNearRest": ["Near-Rest Bunch", "Boolean", "1", "Checked (e.g. a Cathode Emission snapshot, where Pz can be comparable to the transverse momentum): builds a Bunch6dT preserving the full 3D momentum, avoiding the small-angle approximation an at-rest bunch would otherwise need. Unchecked (an already-accelerated bunch, e.g. re-injecting a previous sim's own tracked output downstream, where Pz dominates): builds a Bunch6d using the standard small-angle x'/y' -- required for Sequential (Lattice) positioning, since RF_Track's Lattice.track() has no Bunch6dT support at all."],
            "sigX": ["Laser Spot Size [mm]", "Float", 1.67, "Transverse RMS size of the drive laser on the cathode (radial in x-y)"],
            "riseTime": ["Laser Rise Time, rt", "Float", 0.0003, "Laser pulse rise/fall time, in Bunch6dT_Generator.rt units"],
            "flatTopLength": ["Laser Flat-top Length, lt", "Float", 0.006, "Laser pulse flat-top length, in Bunch6dT_Generator.lt units"],
            "cutoffX": ["Cutoff X [sigma]", "Float", 3, "Truncate the horizontal distribution at this many sigma"],
            "cutoffY": ["Cutoff Y [sigma]", "Float", 3, "Truncate the vertical distribution at this many sigma"],
            "cutoffT": ["Cutoff T [sigma]", "Float", 3, "Truncate the longitudinal distribution at this many sigma"],
            "ePhoton": ["Photon Energy [eV]", "Float", 4.73, "Drive laser photon energy"],
            "phiEff": ["Effective Work Function [eV]", "Float", 3.5, "Cathode effective work function"],
            "noiseReduc": ["Noise Reduction", "Boolean", "1", "Bunch6dT_Generator.noise_reduc"]
        },
        "bunchReport": {
            "x": ["Horizontal Value to Plot", "PhaseSpaceCoordinate", "x"],
            "y": ["Vertical Value to Plot", "PhaseSpaceCoordinate", "xp"],
            "plotType": ["Plot Type", "PlotType", "3d"],
            "histogramBins": ["Histogram Bins", "Integer", 50],
            "colorMap": ["Color Map", "ColorMap", "viridis"],
            "aspectRatio": ["Aspect Ratio", "AspectRatio", "1"],
            "notes": ["Notes", "Text", ""]
        },
        "elementAnimation": {
            "x": ["Horizontal Value to Plot", "PhaseSpaceCoordinate", "x"],
            "y": ["Vertical Value to Plot", "PhaseSpaceCoordinate", "xp"],
            "plotType": ["Plot Type", "PlotType", "3d"],
            "histogramBins": ["Histogram Bins", "Integer", 50],
            "colorMap": ["Color Map", "ColorMap", "viridis"],
            "aspectRatio": ["Aspect Ratio", "AspectRatio", "1"],
            "notes": ["Notes", "Text", ""],
            "reportIndex": ["", "Integer"]
        },
        "simulation": {
            "elementPosition": ["Element Positioning", "ElementPosition", "absolute", "Absolute uses RF_Track's Volume, which places every element at its own explicit (possibly overlapping) position -- required when elements physically share space, e.g. a gun cavity and a bucking solenoid, and the only option that supports the Cathode Emission or From File distributions (RF_Track's Lattice has no tracking support for those). Relative uses RF_Track's Lattice, which appends elements sequentially (gaps become Drifts; overlapping elements are rejected); this cannot be changed once the simulation is created since Volume- and Lattice-only settings (e.g. the tracking range, or the ODE step size) are not interchangeable."],
            "visualizationBeamlineId": ["Beamline", "LatticeBeamlineList", ""]
        },
        "simulationSettings": {
            "spaceCharge": ["Space Charge", "SpaceChargeMethod", "none", "Method used to compute space-charge forces during tracking"],
            "scGridNx": ["Grid Points X", "Integer", 8, "SpaceCharge_PIC_FreeSpace grid size in x"],
            "scGridNy": ["Grid Points Y", "Integer", 8, "SpaceCharge_PIC_FreeSpace grid size in y"],
            "scGridNz": ["Grid Points Z", "Integer", 16, "SpaceCharge_PIC_FreeSpace grid size in z"],
            "scDtMm": ["Time Step [mm/c]", "Float", 3.0, "Volume.sc_dt_mm: time step used for space-charge force updates"],
            "scSmooth": ["Smoothing Factor", "Float", 0.5, "SpaceCharge_PIC_FreeSpace.set_smooth: grid smoothing factor"],
            "scMirror": ["Mirror Position [m]", "Float", 0.0, "SpaceCharge_PIC_FreeSpace.set_mirror: z position of a conducting boundary (e.g. the cathode plane) used for image-charge effects"],
            "autophase": ["Autophase RF Elements", "Boolean", "0", "Automatically set each RF cavity's phase relative to the beam before tracking. The Phase field on each cavity is then interpreted as an offset from the on-crest phase."],
            "autoTrackingRange": ["Automatically Compute Tracking Range", "Boolean", "1", "Volume.set_s0()/set_s1() define which portion of every element's field is active during tracking, not just where particles are reported -- an element positioned so it starts before the beam (e.g. a solenoid whose field map is centered on a point upstream of the cathode) will have that leading portion silently excluded unless the tracking range is extended to cover it. When enabled, the range spans every element's full extent; disable to set it explicitly, e.g. to start tracking exactly at the beam origin even when an upstream element's field extends earlier."],
            "trackingS0": ["Tracking Start [m]", "Float", 0.0, "Volume.set_s0(): start of the active tracking range"],
            "trackingS1": ["Tracking End [m]", "Float", 10.0, "Volume.set_s1(): end of the active tracking range"]
        },
