            "emit_x": ["Horizontal Normalized Emittance [mm-mrad]", "RPNValue", 1.0],
            "emit_y": ["Vertical Normalized Emittance [mm-mrad]", "RPNValue", 1.0],
            "beta_x": ["Horizontal Beta [m]", "RPNValue", 1.0],
            "beta_y": ["Vertical Beta [m]", "RPNValue", 1.0],
            "alpha_x": ["Horizontal Alpha", "RPNValue", 0.0],
            "alpha_y": ["Vertical Alpha", "RPNValue", 0.0],
            "sigma_t": ["Bunch Length [mm/c]", "RPNValue", 1.0],
            "sigma_pt": ["Relative Energy Spread [permille]", "RPNValue", 1.0],
            "distributionType": ["Distribution", "BeamDistributionType", "twiss", "Twiss parameters generate a bunch analytically. Cathode Emission models photoemission from a cathode with RF_Track's Bunch6dT_Generator, tracked from rest. From File loads a previously-saved particle bunch from an OpenPMD HDF5 file."],
            "distributionFile": ["Distribution File", "InputFile", "", "OpenPMD HDF5 file (iteration 0) containing a saved particle bunch: per-particle position (m), momentum (kg*m/s), and optionally time (s), for the species selected above. Accepts files from this app's own OpenPMD download (any report) or from the AWA rftrack_utils posproc.save_bunch_to_openpmd() helper."],
            "fromFileNearRest": ["Near-Rest Bunch", "Boolean", "1", "Checked (e.g. a Cathode Emission snapshot, where Pz can be comparable to the transverse momentum): builds a Bunch6dT preserving the full 3D momentum, avoiding the small-angle approximation an at-rest bunch would otherwise need. Unchecked (an already-accelerated bunch, e.g. re-injecting a previous sim's own tracked output downstream, where Pz dominates): builds a Bunch6d using the standard small-angle x'/y' -- required for Sequential (Lattice) positioning, since RF_Track's Lattice.track() has no Bunch6dT support at all."],
            "laserTransverseProfile": ["Laser Transverse Profile", "CathodeTransverseProfile", "r", "Bunch6dT_Generator.dist_x and dist_y: a radially uniform spot, or a round Gaussian spot"],
            "sigX": ["Laser Spot Size [mm]", "RPNValue", 1.67, "Transverse RMS size of the drive laser on the cathode, the same in x and y"],
            "laserTemporalProfile": ["Laser Temporal Profile", "CathodeTemporalProfile", "plateau", "Bunch6dT_Generator.dist_z: a flat-top pulse (rise time and flat-top length), or a Gaussian pulse (RMS pulse length)"],
            "riseTime": ["Laser Rise Time, rt", "RPNValue", 0.0003, "Laser pulse rise/fall time, in Bunch6dT_Generator.rt units"],
            "flatTopLength": ["Laser Flat-top Length, lt", "RPNValue", 0.006, "Laser pulse flat-top length, in Bunch6dT_Generator.lt units"],
            "sigT": ["Laser Pulse Length, sig_t", "RPNValue", 0.0012, "RMS laser pulse length of a Gaussian pulse, in Bunch6dT_Generator.sig_t units"],
            "cutoffX": ["Cutoff X [sigma]", "RPNValue", 3, "Truncate the horizontal distribution at this many sigma"],
            "cutoffY": ["Cutoff Y [sigma]", "RPNValue", 3, "Truncate the vertical distribution at this many sigma"],
            "cutoffT": ["Cutoff T [sigma]", "RPNValue", 3, "Truncate the longitudinal distribution at this many sigma"],
