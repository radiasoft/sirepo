# Generated by Sirepo -- Monte Carlo uncertainty propagation driver for {{ sub_file }}.

[StochasticTools]
[]

[Distributions]
{% for d in distributions %}
  [{{ d.name }}]
    type = {{ d.type }}
{% for k, v in d.fields %}
    {{ k }} = {{ v }}
{% endfor %}
  []
{% endfor %}
[]

[Samplers]
  [mc]
    type = MonteCarlo
    num_rows = {{ num_rows }}
    distributions = '{{ dist_names }}'
    execute_on = PRE_MULTIAPP_SETUP
    seed = {{ seed }}
  []
[]

[MultiApps]
  [sub]
    type = SamplerFullSolveMultiApp
    input_files = '{{ sub_file }}'
    sampler = mc
    mode = batch-reset
  []
[]

[Controls]
  [cmdline]
    type = MultiAppSamplerControl
    multi_app = sub
    sampler = mc
    param_names = '{{ param_names }}'
  []
[]

[Outputs]
[]
