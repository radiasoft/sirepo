# Monte Carlo uncertainty propagation driver for {{ sub_file }}.

[StochasticTools]
[]

[Distributions]
{% for d in distributions %}
  [{{ d.name }}]
    type = {{ d.type }}
{% for k, v in d.fields %}
    {{ k }} = {{ v }}
{% endfor %}
  []
{% endfor %}
[]

[Samplers]
  [mc]
    type = MonteCarlo
    num_rows = {{ num_rows }}
    distributions = '{{ dist_names }}'
    execute_on = PRE_MULTIAPP_SETUP
    seed = {{ seed }}
  []
[]

[MultiApps]
  [sub]
    type = SamplerFullSolveMultiApp
    input_files = '{{ sub_file }}'
    sampler = mc
    mode = batch-reset
    # some sampled parameter combinations may not converge -- skip them
    # rather than aborting the whole batch (requires
    # Executioner/error_on_dtmin = false in {{ sub_file }}, which
    # write_parameters sets automatically for Monte Carlo runs)
    ignore_solve_not_converge = true
  []
[]

[Controls]
  [cmdline]
    type = MultiAppSamplerControl
    multi_app = sub
    sampler = mc
    param_names = '{{ param_names }}'
  []
[]

[Outputs]
[]
