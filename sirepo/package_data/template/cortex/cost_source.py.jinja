"""Standalone tea cost-model script for '{{ material_name_text }}'.

Computes manufacturing cost using tea's Design-for-Manufacture (DFM)
relative-cost-coefficient method: fabrication cost per process is
Rc * Pc, where Pc is a base processing-cost curve and Rc combines
material/process compatibility with geometry-driven complexity/size/
tolerance/finish coefficients. Material cost is added from the
composition's per-element cost.

Generated by the Sirepo CORTEX.
tea source: https://github.com/aprilnovak/cortex/tree/main/tea

"""

import component_def
import material_def
import pprint
import tea_api

material = material_def.build_material(
    name={{ material_name }},
    density={{ material_density }},
    composition={{ composition }},
    remainder_element={{ remainder_element }},
    Cmp_map={},
)

geometry = component_def.build_geometry(
    name={{ geometry_name }},
    volume_mm3={{ geometry_volume_mm3 }},
    section_thickness_mm={{ geometry_section_thickness_mm }},
    shape_class={{ geometry_shape_class }},
    tolerance_mm={{ geometry_tolerance_mm }},
    surface_finish_um_ra={{ geometry_surface_finish_um_ra }},
    Cc_map={{ cc_map }},
    Cs_map={{ cs_map }},
    Ct_map={{ ct_map }},
    Cf_map={{ cf_map }},
)

process_specs = {{ process_specs }}

result = tea_api.evaluate(
    material=material,
    processes=process_specs,
    volume_mm3=geometry.volume_mm3,
    production_qty={{ production_qty }},
    geometry=geometry,
    component_name=material.name,
)
pprint.pprint(result["summary"])
