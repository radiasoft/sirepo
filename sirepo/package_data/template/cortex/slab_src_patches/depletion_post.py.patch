+# ──────────────────────────────────────────────────────────────────────────────
+# FLATTEN OUTPUT — move every png (and its companion .json) to the root of
+# the simulation run_dir so the frontend can find them by basename alone.
+# ──────────────────────────────────────────────────────────────────────────────
+import pykern.pkio
+
+_pngs = pykern.pkio.walk_tree(SIM_DIR, file_re=r"\.png$")
+for _png in _pngs:
+    for _f in (_png, _png.new(basename=_png.basename + ".json")):
+        if not _f.check(file=True):
+            continue
+        _dest = BASE_DIR / _f.basename
+        if _dest.exists() and Path(str(_f)) != _dest:
+            raise RuntimeError(
+                f"[ERROR] refusing to overwrite existing file at run_dir root: {_dest}"
+            )
+        shutil.move(str(_f), str(_dest))
+print(f"[completed] moved {len(_pngs)} png (+ json) files to {BASE_DIR}")
