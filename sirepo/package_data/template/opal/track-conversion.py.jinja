import numpy
import scipy.constants
import scipy.interpolate
import struct
from pykern.pkcollections import PKDict


def _read_3d_file(filename):
    v = numpy.loadtxt(filename, skiprows=2).reshape((-1, 3))
    h = v[:3]
    return v[3:], PKDict(
        x=f"{h[0][0]} {h[0][1]}",
        nx=int(h[0][2]),
        y=f"{h[1][0]} {h[1][1]}",
        ny=int(h[1][2]),
        z=f"0.0 {h[2][1] - h[2][0]}",
        nz=int(h[2][2]),
    )


def _write_cavity_3d(filename, frequency_mhz):
    v, h = _read_3d_file(filename)
    v = v.reshape((h.nx, h.ny, h.nz, 2, 3))
    v[:, :, :, 0, :] /= 10000  # V/cm to MV/m
    v[:, :, :, 1, :] *= 79.58  # Gauss to A/m
    for i in range(3):
        v = numpy.flip(v, axis=i)
    with open(filename, "w") as f:
        f.write(
            f"3DDynamic FALSE\n{frequency_mhz}\n{h.x} {h.nx - 1}\n{h.y} {h.ny - 1}\n{h.z} {h.nz - 1}\n"
        )
        numpy.savetxt(f, v.reshape((h.nx * h.ny * h.nz, -1)))


def _write_solenoid_1d(filename):
    v, h = _read_3d_file(filename)
    bz = v.reshape((h.nx, h.ny, h.nz, 3))[int(h.nx / 2), int(h.ny / 2), :, 2]
    bz = scipy.interpolate.interp1d(
        numpy.linspace(0, 1, num=len(bz)), bz, kind="cubic"
    )(numpy.linspace(0, 1, num=len(bz) * 2))
    with open(filename, "w") as f:
        f.write(f"1DMagnetoStatic 50\n{h.z} {len(bz) - 1}\n{h.x} {h.nx - 1}\n")
        numpy.savetxt(f, bz)


def _read_fortran_records(data):
    # ini_dis.dat is a Fortran sequential-unformatted file: each record is
    # wrapped in a 4-byte little-endian length prefix and matching suffix.
    pos = 0
    n = len(data)
    while pos < n:
        reclen = struct.unpack_from("<i", data, pos)[0]
        start = pos + 4
        end = start + reclen
        trail = struct.unpack_from("<i", data, end)[0]
        assert trail == reclen, f"corrupt Fortran record framing at byte {pos}"
        yield data[start:end]
        pos = end + 4


def _write_track_distribution(filename, frequency_mhz):
    def _read_coords():
        # After a run-dependent header, ini_dis.dat holds one 60-byte
        # record per particle:
        #   x[cm], x'[rad], y[cm], y'[rad], csi[rad] (RF phase at frequency_mhz),
        #   bg (beta*gamma), Nseed[int32], spin[double]
        with open(filename, "rb") as f:
            data = f.read()
        particle_records = [r for r in _read_fortran_records(data) if len(r) == 60]
        n = len(particle_records)
        x = numpy.empty(n)
        xp = numpy.empty(n)
        y = numpy.empty(n)
        yp = numpy.empty(n)
        csi = numpy.empty(n)
        beta_gamma = numpy.empty(n)
        for i, rec in enumerate(particle_records):
            x[i], xp[i], y[i], yp[i], csi[i], beta_gamma[i] = struct.unpack_from(
                "<6d", rec, 0
            )
        return PKDict(
            x_cm=x, xp_rad=xp, y_cm=y, yp_rad=yp, csi_rad=csi, beta_gamma=beta_gamma
        )

    d = _read_coords()
    # ini_dis.dat's beta_gamma is derived by TRACK from energy per nucleon
    # (MeV/u) using the atomic mass unit, not the true proton rest mass.
    # Recover that per-nucleon energy, then rebuild beta_gamma using the
    # proton mass so it agrees with the rest of the TRACK->OPAL conversion.
    amu_mev = scipy.constants.physical_constants[
        "atomic mass constant energy equivalent in MeV"
    ][0]
    proton_mev = scipy.constants.physical_constants[
        "proton mass energy equivalent in MeV"
    ][0]
    gamma_amu = numpy.sqrt(1.0 + d.beta_gamma**2)
    energy_mev = (gamma_amu - 1.0) * amu_mev
    gamma = 1.0 + energy_mev / proton_mev
    beta_gamma = numpy.sqrt(gamma**2 - 1.0)
    beta = beta_gamma / gamma
    tx = numpy.tan(d.xp_rad)
    ty = numpy.tan(d.yp_rad)
    pz = beta_gamma / numpy.sqrt(1.0 + tx**2 + ty**2)
    px = pz * tx
    py = pz * ty
    x = d.x_cm * 1e-2
    y = d.y_cm * 1e-2
    dt_sec = d.csi_rad / (2.0 * numpy.pi * frequency_mhz * 1e6)
    z = -beta * scipy.constants.c * dt_sec
    output = numpy.column_stack((x, px, y, py, z, pz))
    with open(filename, "w") as f:
        f.write(f"{len(output)}\n")
        numpy.savetxt(f, output, fmt="%.12e")


{% for c in conversions %}
{% if c.type == "EMS" %}
_write_solenoid_1d("{{ c.lib_file }}")
{% elif c.type == "MWS" %}
_write_cavity_3d("{{ c.lib_file }}", {{ c.frequency_mhz }})
{% else %}
_write_track_distribution("{{ c.lib_file }}", {{ c.frequency_mhz }})
{% endif %}
{% endfor %}
